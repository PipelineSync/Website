<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <meta name="author" content="PipelineSync">
  <meta name="theme-color" content="#05070C">
  <link rel="canonical" href="{{ canonical }}">
  {%- set ogImg %}{% ogImage %}{% endset %}
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="PipelineSync">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ ogImg }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="{{ title | plainTitle }}, PipelineSync">
  {%- if ogType == 'article' %}
  <meta property="article:published_time" content="{% pageDate 'published' %}">
  <meta property="article:modified_time" content="{% pageDate 'modified' %}">
  <meta property="article:publisher" content="https://www.linkedin.com/company/pipelinesync">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImg }}">
  <meta name="twitter:image:alt" content="{{ title | plainTitle }}, PipelineSync">
  {%- if site.analytics.googleSiteVerification %}
  <meta name="google-site-verification" content="{{ site.analytics.googleSiteVerification }}">{% endif %}
  {%- if site.analytics.bingSiteVerification %}
  <meta name="msvalidate.01" content="{{ site.analytics.bingSiteVerification }}">{% endif %}
  {% jsonld %}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="preload" href="/assets/vendor/fa/fa-solid-subset.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ "/assets/vendor/fa/icons.css" | v }}">
  <link rel="stylesheet" href="{{ "/assets/css/site.css" | v }}">
  <link rel="stylesheet" href="{{ "/assets/css/hubspot-chat.css" | v }}">
  <script>document.documentElement.classList.add('js');</script>
  {%- if site.analytics.ga4Id %}
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500, region: {{ site.analytics.consentRegions | dump | safe }} });
    gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'granted' });
    gtag('js', new Date());
    gtag('config', '{{ site.analytics.ga4Id }}');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4Id }}"></script>
  {%- endif %}
</head>
<body data-page="{{ page.url }}">
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="bg-fx" aria-hidden="true"><div class="bg-fx__orb bg-fx__orb--a"></div><div class="bg-fx__orb bg-fx__orb--b"></div><div class="bg-fx__orb bg-fx__orb--c"></div><div class="bg-fx__grid"></div><div class="bg-fx__noise"></div></div>

{% include 'partials/loader.njk' %}
{% include 'partials/header.njk' %}

{{ content | safe }}

{% include 'partials/footer.njk' %}
{% include 'partials/modal.njk' %}

<script src="{{ "/assets/js/site.js" | v }}"></script>
<script src="{{ "/assets/js/analytics.js" | v }}"></script>
{% if pageJs %}<script src="{{ ("/assets/js/" + pageJs) | v }}"></script>{% endif %}
<script src="{{ "/assets/js/roi-calculator.js" | v }}"></script>

<!-- Start of HubSpot Embed Code -->
<script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/247123252.js"></script>
<!-- End of HubSpot Embed Code -->
</body>
</html>
