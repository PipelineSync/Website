<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="{{ robots or 'index, follow' }}">
  <meta name="author" content="PipelineSync">
  <meta name="theme-color" content="#05070C">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:site_name" content="PipelineSync">
  {% if ogImage %}<meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:alt" content="PipelineSync logo">
  <meta property="og:image:type" content="image/png">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  {% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}
  {% if schema %}<script type="application/ld+json">{{ schema | safe }}</script>{% endif %}
  <link rel="icon" href="/icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="{{ "/assets/css/site.css" | v }}">
  <link rel="stylesheet" href="{{ "/assets/css/hubspot-chat.css" | v }}">
  <script>document.documentElement.classList.add('js');</script>
</head>
<body data-page="{{ page.url }}">
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="bg-fx" aria-hidden="true"><div class="bg-fx__orb bg-fx__orb--a"></div><div class="bg-fx__orb bg-fx__orb--b"></div><div class="bg-fx__orb bg-fx__orb--c"></div><div class="bg-fx__grid"></div><div class="bg-fx__noise"></div></div>

{% include 'partials/loader.njk' %}
{% include 'partials/header.njk' %}

{{ content | safe }}

{% include 'partials/footer.njk' %}
{% include 'partials/modal.njk' %}

<script src="{{ "/assets/js/site.js" | v }}"></script>
<script src="https://js-na2.hsforms.net/forms/embed/247123252.js" defer></script>
{% if pageJs %}<script src="{{ ("/assets/js/" + pageJs) | v }}"></script>{% endif %}
<script src="{{ "/assets/js/roi-calculator.js" | v }}"></script>

<!-- Start of HubSpot Embed Code -->
<script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/247123252.js"></script>
<!-- End of HubSpot Embed Code -->
</body>
</html>
