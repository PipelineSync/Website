{% if hero_kanban %}
<div class="n-visual n-visual-kanban" role="region" aria-label="PipelineSync Interactive CRM Kanban Pipeline">
  <div class="n-visual-rings" aria-hidden="true"><span></span><span></span><span></span></div>
  <svg class="n-visual-net" viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id="nvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22e4ff"/><stop offset=".55" stop-color="#8b5cf6"/><stop offset="1" stop-color="#ff3fd2"/></linearGradient>
      <radialGradient id="nvcore"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#22e4ff"/><stop offset="1" stop-color="#8b5cf6" stop-opacity="0"/></radialGradient>
    </defs>
    <g class="n-paths" stroke="url(#nvg)" stroke-width="1.4" stroke-linecap="round">
      <path d="M40 90 C140 90 160 240 240 240"/><path d="M30 240 H240"/><path d="M40 390 C140 390 160 240 240 240"/>
      <path d="M440 90 C340 90 320 240 240 240"/><path d="M450 240 H240"/><path d="M440 390 C340 390 320 240 240 240"/>
      <path d="M240 30 V240"/><path d="M240 450 V240"/>
    </g>
    <g class="n-pulses" stroke="#fff" stroke-width="2.4" stroke-linecap="round">
      <path d="M40 90 C140 90 160 240 240 240"/><path d="M30 240 H240"/><path d="M40 390 C140 390 160 240 240 240"/>
      <path d="M440 90 C340 90 320 240 240 240"/><path d="M450 240 H240"/><path d="M440 390 C340 390 320 240 240 240"/>
      <path d="M240 30 V240"/><path d="M240 450 V240"/>
    </g>
    <g class="n-nodes">
      <circle cx="40" cy="90" r="7"/><circle cx="30" cy="240" r="7"/><circle cx="40" cy="390" r="7"/>
      <circle cx="440" cy="90" r="7"/><circle cx="450" cy="240" r="7"/><circle cx="440" cy="390" r="7"/>
      <circle cx="240" cy="30" r="7"/><circle cx="240" cy="450" r="7"/>
    </g>
    <circle class="n-core-glow" cx="240" cy="240" r="90" fill="url(#nvcore)"/>
  </svg>
  <div class="n-visual-art n-visual-kanban-art">
    {% include 'partials/hero-kanban.njk' %}
  </div>
  <div class="n-chip n-chip-a" aria-hidden="true"><i class="fa-solid {{ hero_chips[0] | default('fa-database') }}"></i></div>
  <div class="n-chip n-chip-b" aria-hidden="true"><i class="fa-solid {{ hero_chips[1] | default('fa-diagram-project') }}"></i></div>
  <div class="n-chip n-chip-c" aria-hidden="true"><i class="fa-solid {{ hero_chips[2] | default('fa-bolt') }}"></i></div>
  <div class="n-chip n-chip-d" aria-hidden="true"><i class="fa-solid {{ hero_chips[3] | default('fa-chart-line') }}"></i></div>
</div>
{% else %}
<div class="n-visual" aria-hidden="true">
  <div class="n-visual-rings"><span></span><span></span><span></span></div>
  <svg class="n-visual-net" viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="nvg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22e4ff"/><stop offset=".55" stop-color="#8b5cf6"/><stop offset="1" stop-color="#ff3fd2"/></linearGradient>
      <radialGradient id="nvcore"><stop offset="0" stop-color="#fff"/><stop offset=".35" stop-color="#22e4ff"/><stop offset="1" stop-color="#8b5cf6" stop-opacity="0"/></radialGradient>
    </defs>
    <g class="n-paths" stroke="url(#nvg)" stroke-width="1.4" stroke-linecap="round">
      <path d="M40 90 C140 90 160 240 240 240"/><path d="M30 240 H240"/><path d="M40 390 C140 390 160 240 240 240"/>
      <path d="M440 90 C340 90 320 240 240 240"/><path d="M450 240 H240"/><path d="M440 390 C340 390 320 240 240 240"/>
      <path d="M240 30 V240"/><path d="M240 450 V240"/>
    </g>
    <g class="n-pulses" stroke="#fff" stroke-width="2.4" stroke-linecap="round">
      <path d="M40 90 C140 90 160 240 240 240"/><path d="M30 240 H240"/><path d="M40 390 C140 390 160 240 240 240"/>
      <path d="M440 90 C340 90 320 240 240 240"/><path d="M450 240 H240"/><path d="M440 390 C340 390 320 240 240 240"/>
      <path d="M240 30 V240"/><path d="M240 450 V240"/>
    </g>
    <g class="n-nodes">
      <circle cx="40" cy="90" r="7"/><circle cx="30" cy="240" r="7"/><circle cx="40" cy="390" r="7"/>
      <circle cx="440" cy="90" r="7"/><circle cx="450" cy="240" r="7"/><circle cx="440" cy="390" r="7"/>
      <circle cx="240" cy="30" r="7"/><circle cx="240" cy="450" r="7"/>
    </g>
    <circle class="n-core-glow" cx="240" cy="240" r="90" fill="url(#nvcore)"/>
  </svg>
  {% if hero_art %}
  <div class="n-visual-art">
    <img src="/assets/img/hero/{{ hero_art }}.webp" alt="" width="{{ hero_art_w | default('960') }}" height="{{ hero_art_h | default('640') }}" loading="eager" fetchpriority="high">
  </div>
  {% else %}
  <div class="n-visual-core">
    <div class="n-dash">
      <div class="n-dash-top"><i></i><i></i><i></i></div>
      <div class="n-dash-bars"><b style="--h:38%"></b><b style="--h:62%"></b><b style="--h:48%"></b><b style="--h:80%"></b><b style="--h:66%"></b><b style="--h:94%"></b></div>
      <svg class="n-dash-line" viewBox="0 0 200 60" preserveAspectRatio="none"><path d="M0 50 L30 42 L60 46 L90 28 L120 32 L150 14 L200 8" stroke="url(#nvg)" stroke-width="2.5" fill="none"/></svg>
      <div class="n-dash-rows"><span></span><span></span><span></span></div>
    </div>
  </div>
  {% endif %}
  <div class="n-chip n-chip-a"><i class="fa-solid {{ hero_chips[0] | default('fa-database') }}"></i></div>
  <div class="n-chip n-chip-b"><i class="fa-solid {{ hero_chips[1] | default('fa-diagram-project') }}"></i></div>
  <div class="n-chip n-chip-c"><i class="fa-solid {{ hero_chips[2] | default('fa-bolt') }}"></i></div>
  <div class="n-chip n-chip-d"><i class="fa-solid {{ hero_chips[3] | default('fa-chart-line') }}"></i></div>
</div>
{% endif %}
