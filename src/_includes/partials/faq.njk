{#- FAQ list. Text lives in src/_data/faq.json so the FAQPage JSON-LD always matches what is shown. -#}
<div class="faq" data-stagger>
  {%- for item in faq %}{% if faqExtended or not item.extendedOnly %}
  <details><summary><h3>{{ item.q }}<small>{{ item.sub }}</small></h3><span class="faq__icon" aria-hidden="true"><i class="fa-solid fa-plus"></i></span></summary><div class="faq__body">{{ item.a }}{% if faqExtended and item.extendedSuffix %}{{ item.extendedSuffix }}{% endif %}</div></details>
  {%- endif %}{% endfor %}
</div>
