{#- Interactive "Revenue Pipeline" console on the home hero. Behaviour lives in assets/js/pages/home.js. -#}
{%- set views = [
  ["overview", "fa-house", "Overview"],
  ["pipeline", "fa-table-columns", "Deal pipeline"],
  ["contacts", "fa-address-book", "Contacts"],
  ["workflows", "fa-diagram-project", "Workflows"],
  ["reports", "fa-chart-pie", "Reports"]
] -%}
{%- set stages = [
  { name: "Qualified", total: 120, deals: [["Northwind", 48, "AR"], ["Vertex Mfg", 72, "JD"]] },
  { name: "Proposal", total: 160, deals: [["Halcyon", 96, "MK"], ["Atlas Freight", 64, "AR"]] },
  { name: "Negotiation", total: 120, deals: [["Blue Harbor", 120, "JD"]] },
  { name: "Closed won", total: 132, deals: [["Ridgeline", 132, "JD"]] }
] -%}
<div class="console__grid">
  <nav class="console__side" aria-label="Dashboard views">
    {%- for v in views %}
    <button type="button" class="console__side-item{% if v[0] == 'pipeline' %} is-active{% endif %}" data-view="{{ v[0] }}" aria-controls="view-{{ v[0] }}" aria-pressed="{{ 'true' if v[0] == 'pipeline' else 'false' }}"><i class="fa-solid {{ v[1] }}" aria-hidden="true"></i><span>{{ v[2] }}</span></button>
    {%- endfor %}
    <div class="console__side-foot" aria-hidden="true"><strong>Data health</strong>98% records complete<div class="meter"><span style="--w:98%"></span></div></div>
  </nav>
  <div class="console__main">
    <div class="kpis" aria-label="Key metrics">
      <div class="kpi"><div class="kpi__label">Won this quarter</div><div class="kpi__value" id="kpiWon">$486k</div><div class="kpi__delta">▲ 18.2%</div></div>
      <div class="kpi"><div class="kpi__label">Open pipeline</div><div class="kpi__value" id="kpiOpen">$400k</div><div class="kpi__delta">▲ 6.1%</div></div>
      <div class="kpi"><div class="kpi__label">Speed to lead</div><div class="kpi__value">4m 12s</div><div class="kpi__delta">▼ 71%</div></div>
    </div>

    {#- Overview -#}
    <section class="view" id="view-overview" data-view-panel="overview" aria-label="Overview" hidden>
      <div class="chart">
        <span class="chart__label">Pipeline created · 12 weeks</span>
        <svg viewBox="0 0 600 110" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="chartStroke" x1="0" x2="1"><stop offset="0" stop-color="#ffab5e"/><stop offset=".5" stop-color="#ff7a1a"/><stop offset="1" stop-color="#5b8cff"/></linearGradient>
            <linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ff7a1a" stop-opacity=".28"/><stop offset="1" stop-color="#ff7a1a" stop-opacity="0"/></linearGradient>
          </defs>
          <path class="chart__area" d="M0 92 C40 88 60 80 100 82 S160 70 200 66 S260 74 300 58 S360 44 400 48 S460 30 500 28 S560 14 600 10 L600 110 L0 110Z"/>
          <path class="chart__line" d="M0 92 C40 88 60 80 100 82 S160 70 200 66 S260 74 300 58 S360 44 400 48 S460 30 500 28 S560 14 600 10"/>
        </svg>
      </div>
      <div class="ov-grid">
        <div class="panel">
          <h3 class="panel__title">Recent activity</h3>
          <ul class="feed" id="activityFeed" role="list">
            <li><i class="fa-solid fa-route" aria-hidden="true"></i><span><b>Lead routed</b> to AR · SLA met in 42s</span><time>just now</time></li>
            <li><i class="fa-solid fa-code-merge" aria-hidden="true"></i><span><b>1,284 duplicates</b> merged by golden record rules</span><time>8m</time></li>
            <li><i class="fa-solid fa-trophy" aria-hidden="true"></i><span><b>Ridgeline</b> closed won · $132k</span><time>1h</time></li>
          </ul>
        </div>
        <div class="panel">
          <h3 class="panel__title">Tasks due today</h3>
          <ul class="tasks" role="list">
            <li><label><input type="checkbox" id="task1"> Send proposal to Halcyon</label></li>
            <li><label><input type="checkbox" id="task2"> Confirm Blue Harbor legal review</label></li>
            <li><label><input type="checkbox" id="task3" checked> Update Q4 forecast notes</label></li>
          </ul>
        </div>
      </div>
    </section>

    {#- Deal pipeline -#}
    <section class="view" id="view-pipeline" data-view-panel="pipeline" aria-label="Deal pipeline">
      <div class="board__bar">
        <p class="board__hint"><i class="fa-solid fa-hand-pointer" aria-hidden="true"></i> Drag deals between stages.<span class="board__kbd"> Keyboard: focus a deal, then use ← →.</span></p>
        <button class="board__reset" type="button" id="resetBoard" hidden><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Reset</button>
      </div>
      <div class="stage-tabs" id="stageTabs" aria-label="Jump to stage">
        {%- for st in stages %}
        <button type="button" class="stage-tab{% if loop.first %} is-active{% endif %}" data-stage-tab="{{ loop.index0 }}">{{ st.name }} <b>{{ st.deals | length }}</b></button>
        {%- endfor %}
      </div>
      <div class="board" id="heroBoard">
        {%- for st in stages %}
        <div class="board__col" data-stage="{{ loop.index0 }}" role="group" aria-label="{{ st.name }}">
          <div class="board__head"><span>{{ st.name }}</span><b>{{ st.deals | length }}</b></div>
          <div class="board__sum">${{ st.total }}k</div>
          <div class="board__list">
            {%- for d in st.deals %}
            <div class="deal" data-value="{{ d[1] }}" tabindex="0" aria-roledescription="draggable deal"><div class="deal__name">{{ d[0] }}</div><div class="deal__meta"><span>${{ d[1] }}k</span><span>{{ d[2] }}</span></div></div>
            {%- endfor %}
            {%- if loop.first %}
            <button class="board__add" type="button"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add deal</button>
            {%- endif %}
          </div>
        </div>
        {%- endfor %}
      </div>
      <p class="sr-only" id="boardStatus" role="status" aria-live="polite"></p>
    </section>

    {#- Contacts -#}
    <section class="view" id="view-contacts" data-view-panel="contacts" aria-label="Contacts" hidden>
      <div class="view__tools">
        <label class="search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span class="sr-only">Search contacts</span><input type="search" id="contactSearch" placeholder="Search contacts or companies" autocomplete="off"></label>
        <span class="view__count" id="contactCount">8 contacts</span>
      </div>
      <div class="table-wrap">
        <table class="ctable">
          <thead><tr><th scope="col">Contact</th><th scope="col">Lifecycle</th><th scope="col">Owner</th><th scope="col">Lead score</th></tr></thead>
          <tbody id="contactRows">
            {%- for c in [
              ["Maya Chen", "Northwind", "SQL", "AR", 86], ["Daniel Okafor", "Vertex Mfg", "SQL", "JD", 74],
              ["Priya Raman", "Halcyon", "Opportunity", "MK", 91], ["Tom Becker", "Atlas Freight", "Opportunity", "AR", 68],
              ["Sofia Alvarez", "Blue Harbor", "Opportunity", "JD", 88], ["Liam Walsh", "Ridgeline", "Customer", "JD", 97],
              ["Grace Ito", "Cobalt Labs", "MQL", "AR", 52], ["Noah Fischer", "Meridian Co", "Lead", "MK", 31]
            ] %}
            <tr><td><span class="avatar" aria-hidden="true">{{ c[0][0] }}</span><span><b>{{ c[0] }}</b><small>{{ c[1] }}</small></span></td><td><span class="life life--{{ c[2] | lower }}">{{ c[2] }}</span></td><td>{{ c[3] }}</td><td><span class="score"><span style="--w:{{ c[4] }}%"></span></span><span class="score__n">{{ c[4] }}</span></td></tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </section>

    {#- Workflows -#}
    <section class="view" id="view-workflows" data-view-panel="workflows" aria-label="Workflows" hidden>
      <ul class="flows" role="list">
        {%- for w in [
          ["Lead routing · round robin", "Form submitted → assign owner in 60s", 1284, true],
          ["Duplicate prevention", "Contact created → match on email + domain", 9612, true],
          ["Stalled deal alert", "No activity 7 days → Slack the owner", 214, true],
          ["Renewal reminder", "90 days before renewal → create task", 58, false]
        ] %}
        <li class="flow{% if w[3] %} is-on{% endif %}">
          <span class="flow__icon" aria-hidden="true"><i class="fa-solid fa-bolt"></i></span>
          <span class="flow__body"><b>{{ w[0] }}</b><small>{{ w[1] }}</small></span>
          <span class="flow__count"><b data-enrolled="{{ w[2] }}">{{ w[2] | string | replace(r/\B(?=(\d{3})+(?!\d))/g, ",") }}</b><small>enrolled</small></span>
          <button type="button" class="switch" role="switch" aria-checked="{{ 'true' if w[3] else 'false' }}" aria-label="{{ w[0] }}"><span></span></button>
        </li>
        {%- endfor %}
      </ul>
    </section>

    {#- Reports -#}
    <section class="view" id="view-reports" data-view-panel="reports" aria-label="Reports" hidden>
      <div class="rep-grid">
        <div class="panel">
          <h3 class="panel__title">Closed won by month</h3>
          <div class="bars" role="img" aria-label="Closed won revenue rising from $92k in May to $214k in October">
            {%- for m in [["May", 92], ["Jun", 118], ["Jul", 105], ["Aug", 146], ["Sep", 172], ["Oct", 214]] %}
            <div class="bars__col"><span class="bars__val">${{ m[1] }}k</span><span class="bars__bar" style="--h:{{ (m[1] / 214 * 100) | round }}%"></span><span class="bars__lab">{{ m[0] }}</span></div>
            {%- endfor %}
          </div>
        </div>
        <div class="panel">
          <h3 class="panel__title">Stage funnel <small>from the live board</small></h3>
          <ul class="funnel" id="funnel" role="list">
            {%- for st in stages %}
            <li data-funnel="{{ loop.index0 }}"><span>{{ st.name }}</span><span class="funnel__bar"><span></span></span><b>{{ st.deals | length }}</b></li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </section>
  </div>
</div>
