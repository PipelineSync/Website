<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="cta-band reveal reveal--scale">
      <span class="eyebrow"><span class="eyebrow__dot"></span>{{ ctaEyebrow or "Get started" }}</span>
      <h2 id="contact-heading">{{ ctaTitle }}</h2>
      <p>{{ ctaText }}</p>
      <div class="btn-row">
        <a href="#contact" class="btn btn-primary btn-lg js-open-hs-form">Book a free consultation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
      <p class="cta-band__meta">We reply within 24 hours on business days. No sales sequence. One reply from the person who will actually look at your setup.</p>
      <div class="contact-list">
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="tel:+16467292936"><i class="fa-solid fa-phone" aria-hidden="true"></i>+1 (646) 729-2936</a>
        <a href="https://wa.me/639301228191" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>+63 930 122 8191 (WhatsApp)</a>
      </div>
    </div>
  </div>
</section>
