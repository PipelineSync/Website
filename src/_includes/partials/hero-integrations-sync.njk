{# Integrations hero visual — "Sync monitor".
   A HubSpot core pill on the left, six tool pills on the right, curved links
   carrying packets in both directions, and a mono console streaming sync
   lines. Once per lap one link degrades (retry, error, heal) and the next lap
   degrades a different link. Tool pills use monochrome theme-tinted icons
   only — no brand colours or logo artwork. Driven by
   assets/js/pages/integrations.js. Decorative only. #}
<div class="n-visual n-visual-sync" aria-hidden="true">
  <div class="n-visual-rings"><span></span><span></span></div>

  <div class="sy-board" data-sy-board>
    <div class="sy-top">
      <span class="sy-top-title"><i class="sy-signal"></i>Live sync</span>
      <span class="sy-status" data-sy-status>all systems normal</span>
    </div>

    <div class="sy-map" data-sy-map>
      <svg class="sy-links" viewBox="0 0 560 380" fill="none" data-sy-svg>
        <path data-sy-link="0" d="M152,190 C240,190 230,60 322,60"/>
        <path data-sy-link="1" d="M152,190 C220,190 250,190 322,190"/>
        <path data-sy-link="2" d="M152,190 C240,190 230,320 322,320"/>
        <path data-sy-link="3" d="M152,190 C300,190 300,60 442,60"/>
        <path data-sy-link="4" d="M152,190 C280,190 320,190 442,190"/>
        <path data-sy-link="5" d="M152,190 C300,190 300,320 442,320"/>
        <g class="sy-packets" data-sy-packets>
          <circle r="3.6" data-sy-l="0" data-sy-d="0"/><circle r="3.6" data-sy-l="0" data-sy-d="1"/>
          <circle r="3.6" data-sy-l="1" data-sy-d="0"/><circle r="3.6" data-sy-l="1" data-sy-d="1"/>
          <circle r="3.6" data-sy-l="2" data-sy-d="0"/><circle r="3.6" data-sy-l="2" data-sy-d="1"/>
          <circle r="3.6" data-sy-l="3" data-sy-d="0"/><circle r="3.6" data-sy-l="3" data-sy-d="1"/>
          <circle r="3.6" data-sy-l="4" data-sy-d="0"/><circle r="3.6" data-sy-l="4" data-sy-d="1"/>
          <circle r="3.6" data-sy-l="5" data-sy-d="0"/><circle r="3.6" data-sy-l="5" data-sy-d="1"/>
        </g>
      </svg>
      <span class="sy-core"><i class="fa-brands fa-hubspot"></i><b>HubSpot</b></span>
      <span class="sy-tool" data-sy-tool="0" style="--x:66.4%;--y:15.8%"><i class="fa-brands fa-salesforce"></i><b>Salesforce</b></span>
      <span class="sy-tool" data-sy-tool="1" style="--x:66.4%;--y:50%"><i class="fa-brands fa-mailchimp"></i><b>Mailchimp</b></span>
      <span class="sy-tool" data-sy-tool="2" style="--x:66.4%;--y:84.2%"><i class="fa-brands fa-google"></i><b>Google Ads</b></span>
      <span class="sy-tool" data-sy-tool="3" style="--x:87.9%;--y:15.8%"><i class="fa-brands fa-slack"></i><b>Slack</b></span>
      <span class="sy-tool" data-sy-tool="4" style="--x:87.9%;--y:50%"><i class="fa-solid fa-file-invoice-dollar"></i><b>QuickBooks</b></span>
      <span class="sy-tool" data-sy-tool="5" style="--x:87.9%;--y:84.2%"><i class="fa-solid fa-video"></i><b>Zoom</b></span>
      <span class="sy-badge" data-sy-badge>retry 1 of 3</span>
    </div>

    <div class="sy-console" data-sy-console>
      <p>salesforce -&gt; hubspot &middot; 1,284 records &middot; 2.1s &middot; ok</p>
      <p>hubspot -&gt; slack &middot; 312 events &middot; 0.8s &middot; ok</p>
      <p>mailchimp -&gt; hubspot &middot; 946 contacts &middot; 1.4s &middot; ok</p>
      <p>hubspot -&gt; quickbooks &middot; 58 invoices &middot; 1.1s &middot; ok</p>
    </div>
  </div>

  <div class="n-chip n-chip-a"><i class="fa-solid {{ hero_chips[0] | default('fa-plug') }}"></i></div>
  <div class="n-chip n-chip-b"><i class="fa-solid {{ hero_chips[1] | default('fa-puzzle-piece') }}"></i></div>
  <div class="n-chip n-chip-c"><i class="fa-solid {{ hero_chips[2] | default('fa-arrows-rotate') }}"></i></div>
  <div class="n-chip n-chip-d"><i class="fa-solid {{ hero_chips[3] | default('fa-cloud') }}"></i></div>
</div>
