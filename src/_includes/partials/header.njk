{%- set navItems = [
  { href: "/", label: "Home" },
  { href: "/solutions/", label: "Solutions" },
  { href: "/integrations/", label: "Integrations" },
  { href: "/resources/", label: "Resources" },
  { href: "/about/", label: "About" }
] -%}
<header class="site-header" id="siteHeader">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="PipelineSync home">
      <picture><source srcset="/assets/img/logo-only.webp" type="image/webp"><img src="/assets/img/logo-only.png" alt="" width="478" height="641"></picture>
      <span class="brand__name">PipelineSync</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <span class="nav__pill" aria-hidden="true"></span>
      {%- for item in navItems %}
      {%- set isCurrent = (page.url == item.href) or (item.href != "/" and page.url.startsWith(item.href) and not page.url.startsWith("/about/privacy-policy/")) %}
      <a href="{{ item.href }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
    <div class="header-cta">
      <a href="#contact" class="btn btn-primary btn-sm js-open-hs-form">Book a free consultation <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      <button class="menu-toggle" id="menuToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobileMenu" aria-label="Mobile">
  {%- for item in navItems %}
  {%- set isCurrent = (page.url == item.href) or (item.href != "/" and page.url.startsWith(item.href) and not page.url.startsWith("/about/privacy-policy/")) %}
  <a href="{{ item.href }}"{% if isCurrent %} aria-current="page"{% endif %}>{{ item.label }}</a>
  {%- endfor %}
  <a href="#contact" class="btn btn-primary btn-lg js-open-hs-form">Book a free consultation</a>
  <p class="mobile-menu__meta"><a href="mailto:" data-contact-email>Contact email</a><br><a href="tel:+16467292936">+1 (646) 729-2936</a></p>
</div>
