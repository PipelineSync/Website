        {%- endfor %}
      </div>
      <div class="orbit__spin orbit__spin--1">
        {%- for n in [["salesforce", 30], ["zapier", 150], ["pipedrive-1", 270]] %}
        <div class="orbit__node" style="--a:{{ n[1] }}deg"><img src="/assets/img/integration-logo-{{ n[0] }}.png" alt="" width="40" height="40"></div>
        {%- endfor %}
      </div>
      <div class="orbit__pulse"></div>
      <div class="orbit__core"><img src="/assets/img/integration-logo-hubspot.png" alt="" width="40" height="40"></div>
    </div>
  </div>
</section>

<section class="section section--line" id="integration-library" aria-labelledby="library-heading">
