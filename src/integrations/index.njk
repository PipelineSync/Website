    <div class="int-grid" id="integrationGrid" data-stagger>
      {%- for it in integrations %}
      <article class="card int-card" data-cat="{{ it[0] }}">
        <div class="int-card__top">
          <div class="int-logo"><picture><source srcset="/assets/img/integration-logo-{{ it[1] }}.webp" type="image/webp"><img src="/assets/img/integration-logo-{{ it[1] }}.png" alt="{{ it[2] }} logo" width="40" height="40" loading="lazy" decoding="async"></picture></div>
