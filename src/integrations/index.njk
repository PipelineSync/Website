      {%- endfor %}
    </div>
    <p class="sr-only" id="integrationCount" role="status" aria-live="polite"></p>
    {%- set integrations = [
      ["crm", "hubspot", "HubSpot", "Native", "Core CRM, source of truth for GTM"],
      ["crm", "salesforce", "Salesforce", "Custom API", "Bi-directional sync with dedupe & field mapping"],
