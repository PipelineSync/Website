      ["marketing", "facebook", "Facebook Ads", "Native", "Lead ads + conversion API"],
      ["marketing", "linkedin", "LinkedIn Ads", "Custom API", "Matched audiences & lead gen forms"],
      ["comm", "slack", "Slack", "Native", "Deal alerts, ticket routing, approvals"],
      ["comm", "microsoftteams", "Microsoft Teams", "Native", "Notifications & collaborative deal rooms"],
      ["comm", "zoom", "Zoom", "Native", "Meeting sync, transcripts, follow-up automation"],
      ["comm", "aircall", "Aircall", "Native", "Call logging, recordings, power dialer"],
      ["comm", "aloware", "Aloware", "Custom API", "SMS & voice automation with HubSpot triggers"],
      ["finance", "quickbooks", "QuickBooks", "Custom API", "Invoices, payments, revenue recognition"],
      ["finance", "xero", "Xero", "Custom API", "Accounting sync & deal-to-cash flow"],
      ["finance", "stripe", "Stripe", "Native", "Subscriptions, invoices, payment links"],
      ["finance", "pandadoc", "PandaDoc", "Custom API", "Proposals, eSign, deal automation"],
      ["data", "googleanalytics", "Google Analytics", "Native", "Traffic, conversion, attribution modeling"],
      ["data", "looker", "Looker Studio", "Custom API", "Custom dashboards & blended data sources"],
      ["data", "databox", "Databox", "Custom API", "KPI dashboards & TV mode reporting"],
      ["custom", "zapier", "Zapier", "Native", "No-code automation for long-tail tools"],
