      <button class="tab-btn" type="button" role="tab" id="tabbtn-blog" data-tab="blog" aria-controls="tab-blog" aria-selected="false" tabindex="-1">Articles</button>
      <button class="tab-btn" type="button" role="tab" id="tabbtn-sops" data-tab="sops" aria-controls="tab-sops" aria-selected="false" tabindex="-1">SOPs and Templates</button>
      <button class="tab-btn" type="button" role="tab" id="tabbtn-faq" data-tab="faq" aria-controls="tab-faq" aria-selected="false" tabindex="-1">FAQs</button>
    </div>

    <div class="tab-panel mt-lg" id="tab-guides" role="tabpanel" aria-labelledby="tabbtn-guides">
      <div class="section-head section-head--center reveal">
        <h2>From messy portal to working system</h2>
        <p>Five guides covering the problems we are hired to fix most often.</p>
      </div>
      <div class="grid grid-3" data-stagger>
        {%- for r in [
          ["/resources/hubspot-crm-architecture-blueprint/", "fa-sitemap", "", "Guide • 12 min", "HubSpot CRM Architecture Blueprint", "How to structure objects, pipelines, lifecycle stages, and permissions so the portal still works when you have ten times the data.", "Read guide"],
          ["/resources/crm-cleanup-deduplication-system-pipelinesync/", "fa-broom", "card-icon--cyan", "Playbook • 18 min", "CRM Cleanup and Deduplication System", "A step-by-step process to audit, merge, and enrich records, then the validation rules that stop duplicates coming back.", "Read playbook"],
          ["/resources/lead-routing-lifecycle-automation-pipelinesync/", "fa-bolt", "card-icon--green", "Automation • 15 min", "Lead Routing and Lifecycle Automation", "Building routing your sales team trusts: scoring, assignment, SLAs, fallback owners, and escalation.", "Read guide"],
          ["/resources/integration-governance-monitoring-pipelinesync/", "fa-plug", "card-icon--blue", "Integrations • 14 min", "Integration Governance and Monitoring", "Designing bidirectional syncs with clear field ownership, logging, alerting, and a rollback path.", "Read guide"],
          ["/resources/full-funnel-attribution-that-ceos-trust-pipelinesync/", "fa-chart-column", "", "Attribution • 16 min", "Full-Funnel Attribution Leadership Can Trust", "Connecting first touch to closed won: campaign influence, multi-touch models, and revenue dashboards.", "Read guide"]
        ] %}
        <article class="card card--link" data-card-url="{{ r[0] }}">
          <div class="card-icon {{ r[2] }}"><i class="fa-solid {{ r[1] }}" aria-hidden="true"></i></div>
          <span class="tag tag--brand" style="margin-bottom:14px">{{ r[3] }}</span>
          <h3>{{ r[4] }}</h3>
          <p>{{ r[5] }}</p>
          <a href="{{ r[0] }}" class="link-arrow">{{ r[6] }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        {%- endfor %}
      </div>
    </div>

    <div class="tab-panel mt-lg" id="tab-blog" role="tabpanel" aria-labelledby="tabbtn-blog" hidden>
      <div class="section-head section-head--center">
        <h2>Field notes</h2>
      </div>
      <div class="grid grid-2">
        {%- for r in [
          ["/resources/why-your-hubspot-pipeline-doesnt-reflect-reality-pipelinesync/", "fa-database", "", "RevOps • 5 min", "Why Your HubSpot Pipeline Does Not Reflect Reality", "Stages reps skip, close dates nobody updates, and the three changes that fix a forecast."],
          ["/resources/the-cost-of-duplicate-data-in-hubspot-pipelinesync/", "fa-chart-line", "card-icon--blue", "Data • 7 min", "What Duplicate Data Actually Costs You", "Where duplicates do real damage: broken reporting, misrouted leads, and rep time spent reconciling records."],
          ["/resources/automation-that-saves-10-hours-week-pipelinesync/", "fa-robot", "card-icon--cyan", "Automation • 6 min", "Automation That Saves Your Team Hours Every Week", "The workflows we build in almost every portal: lead routing, data hygiene, and follow-up."],
          ["/resources/why-teams-dont-adopt-hubspot-and-how-we-fix-it-pipelinesync/", "fa-users", "card-icon--green", "Teams • 4 min", "Why Teams Do Not Adopt HubSpot", "Adoption is usually an architecture problem, not a training problem."]
        ] %}
        <article class="card card--link" data-card-url="{{ r[0] }}">
          <div class="card-icon {{ r[2] }}"><i class="fa-solid {{ r[1] }}" aria-hidden="true"></i></div>
          <span class="tag tag--blue" style="margin-bottom:14px">{{ r[3] }}</span>
          <h3>{{ r[4] }}</h3>
          <p>{{ r[5] }}</p>
          <a href="{{ r[0] }}" class="link-arrow">Read article <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        {%- endfor %}
      </div>
    </div>

    <div class="tab-panel mt-lg" id="tab-sops" role="tabpanel" aria-labelledby="tabbtn-sops" hidden>
      <div class="section-head section-head--center">
        <h2>Templates you can use today</h2>
        <p>Working documents from real projects. Free, no form.</p>
      </div>
      <div class="grid grid-3">
        {%- for r in [
          ["/resources/hubspot-governance-checklist-pipelinesync/", "fa-list-check", "card-icon--green", "Notion template • Free", "HubSpot Governance Checklist", "A 47-point checklist covering permissions, validation rules, naming conventions, and audit trails."],
          ["/resources/data-migration-mapping-sheet-pipelinesync/", "fa-table", "", "Google Sheet • Free", "Data Migration Mapping Sheet", "Field mapping, transformation rules, association handling, and a QA checklist for a clean migration."],
          ["/resources/lead-routing-decision-tree-pipelinesync/", "fa-diagram-project", "card-icon--blue", "Miro board • Free", "Lead Routing Decision Tree", "A flowchart for assignment logic, scoring thresholds, SLAs, fallback owners, and escalation."]
        ] %}
