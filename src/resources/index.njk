          <div class="card-icon {{ r[2] }}"><i class="fa-solid {{ r[1] }}" aria-hidden="true"></i></div>
          <span class="tag tag--green" style="margin-bottom:14px">{{ r[3] }}</span>
          <h3>{{ r[4] }}</h3>
          <p>{{ r[5] }}</p>
          <a href="{{ r[0] }}" class="link-arrow">Open template <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </article>
        {%- endfor %}
      </div>
    </div>

    <div class="tab-panel mt-lg" id="tab-faq" role="tabpanel" aria-labelledby="tabbtn-faq" hidden>
      <div class="section-head section-head--center">
        <h2>Before you book a call</h2>
      </div>
      {% set faqExtended = true %}
      {% include 'partials/faq.njk' %}
    </div>
  </div>
</section>

