---
permalink: sitemap.xml
sitemap: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- for item in collections.all | sort(attribute='url') %}
{%- if item.data.sitemap != false and item.url != '/404.html' and not ('noindex' in (item.data.robots or '')) %}
{%- set dates = item | sitemapDate %}
  <url>
    <loc>https://pipelinesync.net{{ item.url }}</loc>
    <lastmod>{{ dates.modified }}</lastmod>
  </url>
{%- endif %}
{%- endfor %}
</urlset>
